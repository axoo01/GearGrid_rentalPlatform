@page "{id:int}"
@model GearGrid.Pages.Provider.EquipmentPages.DeleteModel
@{
    ViewData["Title"] = "Delete equipment";
}

<section class="account-page">
    <div class="glass-card account-card">
        <p class="eyebrow">Provider</p>
        <h1>Delete equipment</h1>

        <p class="account-intro">
            <strong>@Model.Item.Name</strong> (@Model.Item.SerialOrAssetCode), @Model.Item.Category.CategoryName
        </p>

        @if (Model.HasOrders)
        {
            <p>This item has rental orders, so it can't be deleted. Set it to <strong>Maintenance</strong> instead to hide it from renters.</p>
            <a asp-page="/Provider/Equipment/Edit" asp-route-id="@Model.Item.EquipmentId" class="glass-btn glass-btn-primary">Edit item</a>
            <a asp-page="/Provider/Equipment/Index" class="glass-btn">Back</a>
        }
        else
        {
            <p>This can't be undone. Are you sure?</p>
            <form method="post">
                <button type="submit" class="glass-btn glass-btn-primary">Yes, delete</button>
                <a asp-page="/Provider/Equipment/Index" class="glass-btn">Cancel</a>
            </form>
        }
    </div>
</section>
