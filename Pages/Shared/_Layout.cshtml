<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GearGrid</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GearGrid.styles.css" asp-append-version="true" />
</head>
<body class="@(ViewData["AccountModal"] is true ? "account-modal-open" : null)">
    <header class="site-header site-shell">
        <nav class="glass-nav" aria-label="Main navigation">
            <a class="brand" asp-page="/Index" aria-label="GearGrid home">Gear<span>Grid</span></a>
            <div class="desktop-nav">
                <a asp-page="/Browse">Browse</a>
                <a asp-page="/Provider">List Equipment</a>
                <a asp-page="/Renter">My Rentals</a>
            </div>
            <div class="nav-account">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-user-name">@User.Identity.Name</span>
                    <form method="post" asp-page="/Account/Logout">
                        <button class="nav-logout" type="submit">Log out</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Account/Login">Log in</a>
                    <a class="account-register" asp-page="/Account/Register">Sign up</a>
                }
            </div>
            <details class="mobile-menu">
                <summary aria-label="Open navigation menu">Menu</summary>
                <div>
                    <a asp-page="/Browse">Browse</a>
                    <a asp-page="/Provider">List Equipment</a>
                    <a asp-page="/Renter">My Rentals</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="nav-user-name">@User.Identity.Name</span>
                        <form method="post" asp-page="/Account/Logout">
                            <button class="nav-logout" type="submit">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Account/Login">Log in</a>
                        <a asp-page="/Account/Register">Sign up</a>
                    }
                </div>
            </details>
        </nav>
    </header>

    @if (ViewData["AccountModal"] is true)
    {
        <main role="main" class="site-shell site-main homepage-backdrop">
            @await Component.InvokeAsync("HomepageContent")
        </main>
        <div class="account-modal-backdrop">
            <div class="account-modal-dialog" role="dialog" aria-modal="true" aria-label="@ViewData["Title"]">
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        <main role="main" class="site-shell site-main">
            @RenderBody()
        </main>
    }

    <footer class="site-footer">
        <div class="site-shell">&copy; @DateTime.UtcNow.Year GearGrid</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
